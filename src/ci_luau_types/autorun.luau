local ReflectionService = DataModel:get_service("ReflectionService")
local IOService = DataModel:get_service("IOService")
local descriptors = ReflectionService:get_descriptors()
local typesFile =
	"-- This file has been auto-generated by src/ci_luau_types. Most edits should go to the generator rather than the file.\n"

for _, descriptor in descriptors do
	typesFile ..= `declare class {descriptor.Name}`

	if #descriptor.Parents ~= 0 then
		typesFile ..= " extends "
	end

	for i, parent in descriptor.Parents do
		if i ~= #descriptor.Parents then
			typesFile ..= `{parent}, `
		else
			typesFile ..= parent
		end
	end

	typesFile ..= "\n"
	typesFile ..= `ClassName: {descriptor.Name}\n`

	for _, property in descriptor.Properties do
		typesFile ..= `\t{property.Name} : {property.Type}\n`
	end

	for _, method in descriptor.Methods do
		typesFile ..= `\tfunction {method.Name}(self`
		for _, parameter in method.Parameters do
			typesFile ..= `, {parameter.Name} : {parameter.Type}`
		end
		typesFile ..= `) : {method.Type}\n`
	end
	typesFile ..= "end\n"
end

print("Generated types successfully")
IOService:write_file("nyanners.d.luau", typesFile)
